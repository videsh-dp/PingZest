# Filled automatically by `shopify app dev`. Set these yourself in production.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,write_orders,read_fulfillments,read_discounts,write_discounts,read_locales,write_order_edits,write_merchant_managed_fulfillment_orders,write_app_proxy
# MongoDB. Local: `docker compose up -d` (see docker-compose.yml). Production: MongoDB Atlas.
DATABASE_URL="mongodb://localhost:27017/pingzest?replicaSet=rs0&directConnection=true"
GOOGLE_TRANSLATE_API_KEY=   # optional: enables Auto-translate buttons
BILLING_TEST=true           # set to false in production to take real payments
SHOPIFY_APP_HANDLE=pingzest # app handle from the Partner Dashboard (billing return URL)
PINGZEST_BRAND_URL=https://apps.shopify.com/pingzest   # link in "Powered by PingZest" (Free plan)
POSTHOG_API_KEY=            # optional: logs, errors, analytics, feature flags (phc_...)
POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com
POSTHOG_STOREFRONT_SAMPLE=0.01          # share of successful storefront calls logged
CRON_SECRET=                # optional, 16+ characters: turns on POST /cron/cod (COD autopilot for quiet stores)

# ---- Local development only ----
# NGROK_DOMAIN=pingzest-dev.ngrok-free.app   # your free static ngrok domain (npm run dev:ngrok)
# DEV_PORT=3000
# SHOPIFY_API_SECRET=...                     # Client secret: needed by npm run test:webhooks
