# Filled automatically by `shopify app dev`. Set these yourself in production.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,write_orders,read_discounts,write_discounts,read_locales
# MongoDB. Local: `docker compose up -d` (see docker-compose.yml). Production: MongoDB Atlas.
DATABASE_URL="mongodb://localhost:27017/pingzest?replicaSet=rs0&directConnection=true"
GOOGLE_TRANSLATE_API_KEY=   # optional: enables Auto-translate buttons
POSTHOG_API_KEY=            # optional: logs, errors, analytics, feature flags (phc_...)
POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com
POSTHOG_STOREFRONT_SAMPLE=0.01          # share of successful storefront calls logged
