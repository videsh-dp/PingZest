{%- comment -%} App block: "Share on WhatsApp" for products or any page. {%- endcomment -%}
{%- assign s = block.settings -%}
{%- comment -%} Untouched default texts follow the shopper's language (locales/*.json). {%- endcomment -%}
{%- assign t_label = s.label -%}{%- if t_label == "Share on WhatsApp" -%}{%- assign t_label = 'blocks.share_button.label' | t -%}{%- endif -%}
{%- assign t_message = s.message -%}{%- if t_message == "Look what I found: {product} {url}" -%}{%- assign t_message = 'blocks.share_button.message' | t -%}{%- endif -%}
{%- liquid
  assign title = page_title
  if product
    assign title = product.title
  endif
-%}
{% render 'wa-config' %}
<div class="wa-block" data-wa-block="share" {{ block.shopify_attributes }}>
  <a href="#" class="wa-btn"
    data-wa-widget="share"
    data-message="{{ t_message | escape }}"
    data-product="{{ title | escape }}"
    rel="noopener" target="_blank">
    {% render 'wa-icon' %}<span>{{ t_label | escape }}</span>
  </a>
</div>

{% schema %}
{
  "name": "Share on WhatsApp",
  "target": "section",
  "stylesheet": "wa-widget.css",
  "javascript": "wa-widget.js",
  "settings": [
    { "type": "text", "id": "label", "label": "Button text", "default": "Share on WhatsApp" },
    { "type": "textarea", "id": "message", "label": "Message", "default": "Look what I found: {product} {url}", "info": "Use {product} and {url}." },
    { "type": "paragraph", "content": "Colours, shape, size and which pages this shows on are set in the WA Assist app → Widgets → Buttons." }
  ]
}
{% endschema %}
