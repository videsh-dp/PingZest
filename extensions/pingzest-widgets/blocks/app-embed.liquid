{%- comment -%}
  App embed: turns on all floating widgets (chat button, discount banner).
  Everything is designed in the PingZest app (Widgets page); this embed only loads it.
{%- endcomment -%}
{% render 'wa-config' %}

{% schema %}
{
  "name": "PingZest widgets",
  "target": "body",
  "stylesheet": "wa-widget.css",
  "javascript": "wa-widget.js",
  "settings": [
    { "type": "paragraph", "content": "Design the chat button and discount banner, and choose which pages they show on, in the PingZest app → Widgets." }
  ]
}
{% endschema %}
