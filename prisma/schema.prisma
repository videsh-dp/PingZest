// MongoDB (local replica set or MongoDB Atlas). DATABASE_URL must include the database name,
// e.g. mongodb+srv://user:pass@cluster.mongodb.net/pingzest. Apply with `npx prisma db push`.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Shopify session storage (same shape as Shopify's app template)
// MongoDB layout from Shopify's PrismaSessionStorage docs: `id` must NOT be `_id`, because the storage
// upserts with `id` inside `update` and MongoDB can't change `_id` ("Invalid prisma.session.upsert()").
model Session {
  dbId          String    @id @default(auto()) @map("_id") @db.ObjectId
  id            String    @unique
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  // Expiring offline tokens (Shopify no longer accepts non-expiring ones): refreshed with this token.
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  shop             String   @id @map("_id")
  storeName        String   @default("")
  whatsappNumber   String   @default("") // store's own number, digits only
  countryCode      String   @default("91")
  defaultLang      String   @default("en") // default message language (any app locale code)
  appLocale        String   @default("auto") // admin language: "auto" = follow Shopify admin
  plan             String   @default("free") // free | pro (see app/lib/plans.js), synced from Shopify billing
  subscriptionId   String? // Shopify AppSubscription gid
  subscriptionName String? // e.g. "PingZest Pro Monthly"
  trialEndsAt      DateTime?
  planCheckedAt    DateTime?
  // COD money-savers (Pro)
  riskTagHigh      Boolean  @default(true)  // add a tag to high-risk COD orders in Shopify
  riskTag          String   @default("pingzest-risk-high")
  prepaidEnabled   Boolean  @default(false) // offer "pay online now" on the confirm page
  prepaidPercent   Float    @default(5)     // discount for paying online, 0 = none
  prepaidMaxAmount Float    @default(0)     // cap on the discount in the order currency, 0 = no cap
  prepaidTag       String   @default("pingzest-cod-to-prepaid")
  addressCheck     Boolean  @default(true)  // let customers fix their address on the confirm page
  confirmedTag     String   @default("wa-cod-confirmed")
  cancelledTag     String   @default("wa-cod-cancelled")
  abandonDelayMin  Int      @default(30)
  // Closing the COD loop (docs/TICKETS.md PZ-01..03)
  codHold          Boolean  @default(false) // hold fulfillment of new COD orders until confirmed
  codRemindHours   Int      @default(24)    // "To remind" after this long without a reply
  codExpireHours   Int      @default(72)    // expire (No reply) after this long
  noReplyTag       String   @default("wa-cod-no-reply")
  codAutoExpire    Boolean  @default(false) // Pro: expire automatically
  cancelOnCustomer Boolean  @default(false) // Pro: cancel in Shopify when the customer cancels
  cancelOnExpire   Boolean  @default(false) // Pro: cancel in Shopify when an order expires
  cancelRestock    Boolean  @default(true)  // restock items when PingZest cancels an order
  codProcessedAt   DateTime? // last time due COD work ran for this shop (throttle)
  rtoCost          Float?   // average cost of one returned COD parcel; null = default for the currency
  // Home setup guide (docs/UI-TICKETS.md UI-05)
  setupDismissedAt DateTime? // merchant closed the setup guide
  embedActiveAt    DateTime? // App Bridge app.extensions() last reported the theme app embed as active
  embedCheckedAt   DateTime? // when that status was last read (active or not)
  embedManual      Boolean  @default(false) // merchant ticked "the embed is on" where the status can't be read
  testSentAt       DateTime? // merchant sent the sample COD message to their own WhatsApp
  // Customer confirm page
  logoUrl          String   @default("") // optional https image shown above the order on the confirm page
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MessageTemplate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  shop      String
  type      String // cod_confirm | cod_reminder | abandoned_cart | shipped | delivered
  lang      String // any app language code (en, hi, es, pt-BR, fr, de, ar)
  name      String
  body      String
  isDefault Boolean  @default(false) // one default per shop + type + lang
  seeded    Boolean  @default(false) // built-in "Standard" template: doesn't count against plan limits
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, type, lang])
}

// One row per message the merchant opened in WhatsApp (for message analytics).
model MessageLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  shop         String
  kind         String // cod_confirm | cod_reminder | abandoned_cart | shipped | delivered
  refId        String   @db.ObjectId // Order.id or Checkout.id
  templateId   String?  @db.ObjectId
  templateName String   @default("")
  lang         String   @default("en")
  day          String // YYYY-MM-DD
  sentAt       DateTime @default(now())

  @@index([shop, day])
  @@index([shop, templateId])
}

model Order {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  shop               String
  shopifyOrderId     String
  orderGid           String
  orderName          String
  customerName       String    @default("")
  phone              String?
  totalPrice         String
  currency           String
  itemsSummary       String    @default("")
  isCod              Boolean   @default(false)
  whatsappOptIn      Boolean   @default(false)
  checkoutToken      String?
  orderStatusUrl     String?
  discountCodes      String    @default("") // comma-separated codes used on the order
  discountAmount     String    @default("0")

  // COD confirmation: pending | sent | confirmed | cancelled | no_reply
  codStatus          String    @default("pending")
  codSentAt          DateTime?
  codRespondedAt     DateTime?
  codRespondedBy     String? // customer | merchant
  codTemplateId      String?   @db.ObjectId
  confirmToken       String? // random, looked up via the index below (not @unique: on MongoDB a
                               // unique index would allow only one order without a token)
  tokenExpiresAt     DateTime?

  // COD risk score (app/lib/risk.js). Only the PIN code and yes/no address checks are stored.
  pincode            String?
  addressFlags       String[]
  riskScore          Int?
  riskLevel          String? // low | medium | high
  riskReasons        Json?   // [{ code, vars }]

  // COD → prepaid (Pro)
  prepaidOfferedAt   DateTime? // customer opened the payment link
  prepaidDiscount    String?   // discount applied for paying online
  paidAt             DateTime? // orders/paid received
  convertedToPrepaid Boolean   @default(false)
  addressUpdatedAt   DateTime? // customer fixed the address on the confirm page

  // Closing the COD loop
  fulfillmentHolds   Json?     // [{ fo, hold }] fulfillment orders PingZest put on hold
  heldAt             DateTime?
  holdReleasedAt     DateTime?
  codRemindedAt      DateTime? // reminder opened in WhatsApp
  codExpiredAt       DateTime? // moved to No reply after the expiry time (by PingZest or the merchant)
  shopifyCancelledAt DateTime? // cancelled in Shopify by PingZest
  actionError        String?   // last failed Shopify action: "hold: <message>" (shown as an alert)
  actionErrorAt      DateTime?

  // Returns analytics (RTO)
  firstOrder         Boolean?  // customer's first order in the store
  placedHour         Int?      // hour of day the order was placed, store's local time (0-23)
  rtoAt              DateTime? // merchant marked the parcel as returned to origin

  // Order updates
  trackingUrl        String?
  shippedAt          DateTime?
  shippedMsgSentAt   DateTime?
  deliveredAt        DateTime?
  deliveredMsgSentAt DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([shop, shopifyOrderId])
  @@index([shop, isCod, codStatus])
  @@index([shop, isCod, riskLevel])
  @@index([shop, phone])
  @@index([shop, pincode])
  @@index([shop, isCod, codStatus, codSentAt])
  @@index([confirmToken])
}

model Checkout {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  shop         String
  token        String
  customerName String    @default("")
  phone        String?
  totalPrice   String
  currency     String
  itemsSummary String    @default("")
  checkoutUrl  String?
  completed    Boolean   @default(false)
  recovered    Boolean   @default(false) // completed after we sent a reminder
  status       String    @default("pending") // pending | sent | dismissed
  sentAt       DateTime?
  templateId   String?   @db.ObjectId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([shop, token])
  @@index([shop, status])
}

// Daily widget counters (no shopper data stored).
// widget: chat | discount | product | cart | share
// event:  view | click | copy | apply
model WidgetEvent {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  shop     String
  widget   String
  event    String
  pageType String @default("other")
  device   String @default("desktop") // desktop | mobile
  day      String // YYYY-MM-DD
  count    Int    @default(0)

  @@unique([shop, widget, event, pageType, device, day])
  @@index([shop, day])
}

// Widget design + page rules, edited in the app. Also copied to the
// pingzest.config shop metafield that the storefront reads.
model WidgetConfig {
  shop      String   @id @map("_id")
  config    String // JSON (see app/lib/widget-config.js)
  syncedAt  DateTime?
  syncError String?
  updatedAt DateTime @updatedAt
}

// Discount codes created from the app (they live in Shopify; this is our copy).
model Discount {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  shop           String
  shopifyGid     String?   // gid://shopify/DiscountCodeNode/...
  code           String
  title          String
  kind           String    // percentage | fixed
  value          Float     // 10 = 10% or 10 currency units
  minSubtotal    Float?
  oncePerCustomer Boolean  @default(true)
  startsAt       DateTime  @default(now())
  endsAt         DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shop, code])
}

// Shopify privacy webhooks, kept as a log. Data requests stay "pending" until the merchant has been
// sent `data` (by hand for now; an email step can read this collection later).
model ComplianceRequest {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  shop              String
  topic             String    // customers/data_request | customers/redact | shop/redact
  webhookId         String?   // Shopify retries webhooks; used to store each one once
  requestId         String?   // data_request.id from Shopify
  shopifyCustomerId String?
  ordersRequested   String[]
  status            String    @default("done") // pending | done | redacted
  data              Json?     // what PingZest holds about the customer (data requests only)
  summary           String    @default("") // e.g. "3 orders, 1 checkout, 4 messages"
  receivedAt        DateTime  @default(now())
  handledAt         DateTime?
  note              String    @default("")

  @@index([status, receivedAt])
  @@index([shop, topic])
  @@index([webhookId])
}
