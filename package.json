{
  "name": "pingzest",
  "private": true,
  "type": "module",
  "description": "WhatsApp widgets, COD confirmation and order messages for Shopify: free plan, manual send (no Meta API).",
  "scripts": {
    "dev": "shopify app dev",
    "dev:ngrok": "node scripts/dev-ngrok.mjs",
    "test:webhooks": "node scripts/send-test-webhooks.mjs",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "setup": "prisma generate && prisma db push",
    "docker-start": "npm run setup && npm run start",
    "deploy": "shopify app deploy",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "test": "node --test test/*.test.js",
    "test:widgets": "node test/widgets.e2e.mjs",
    "test:integration": "node --test --test-concurrency=1 test/integration/server.test.mjs",
    "prisma": "prisma",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/admin.test.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@react-router/dev": "^7.9.0",
    "@react-router/fs-routes": "^7.9.0",
    "@react-router/node": "^7.9.0",
    "@react-router/serve": "^7.9.0",
    "@shopify/app-bridge-react": "^4.2.0",
    "@shopify/shopify-app-react-router": "^1.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^7.0.0",
    "isbot": "^5.1.0",
    "prisma": "^6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.9.0",
    "vite": "^6.3.0",
    "vite-tsconfig-paths": "^5.1.0"
  },
  "devDependencies": {
    "@shopify/cli": "^3.85.0",
    "playwright": "^1.55.0"
  }
}
